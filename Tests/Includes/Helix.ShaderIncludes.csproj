<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8981;CS0649</NoWarn>
    <RootNamespace>Helix.ShaderIncludes</RootNamespace>
    <AssemblyName>Helix.ShaderIncludes</AssemblyName>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../External/Helix.Shaders/Source/HelixEngine.Shaders/HelixEngine.Shaders.csproj" />
  </ItemGroup>
</Project>
